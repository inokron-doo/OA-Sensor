"lora_sensor_network\stm32f0xx_hal_msp.o"
"lora_sensor_network\stm32f0xx_hal_crc.o"
"lora_sensor_network\stm32f0xx_hal_crc_ex.o"
"lora_sensor_network\stm32f0xx_hal_rcc.o"
"lora_sensor_network\stm32f0xx_hal_rcc_ex.o"
"lora_sensor_network\stm32f0xx_hal.o"
"lora_sensor_network\stm32f0xx_hal_i2c.o"
"lora_sensor_network\stm32f0xx_hal_i2c_ex.o"
"lora_sensor_network\stm32f0xx_hal_gpio.o"
"lora_sensor_network\stm32f0xx_hal_dma.o"
"lora_sensor_network\stm32f0xx_hal_cortex.o"
"lora_sensor_network\stm32f0xx_hal_pwr.o"
"lora_sensor_network\stm32f0xx_hal_pwr_ex.o"
"lora_sensor_network\stm32f0xx_hal_flash.o"
"lora_sensor_network\stm32f0xx_hal_flash_ex.o"
